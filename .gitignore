# ── macOS ──
.DS_Store

# ── Xcode build output & user state ──
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside

# ── Generated by XcodeGen (source of truth is project.yml) ──
# The .xcodeproj and any generated Info.plist / entitlements are regenerated by
# `xcodegen generate`, so they are not tracked.
*.xcodeproj/
Config/*.plist
Config/*.entitlements

# ── Swift Package Manager (if ever added) ──
.build/
.swiftpm/

# ── Python (city-dataset build script, tools/build_cities.py) ──
__pycache__/
*.pyc
.venv/
venv/

# Note: the generated Resources/cities.json IS committed (static, CC-BY, reproducible
# via tools/build_cities.py). Do not ignore it.
