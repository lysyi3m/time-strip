# ── macOS ──
.DS_Store

# ── Xcode build output & user state ──
build/
DerivedData/
*.dmg
*.xcuserstate
xcuserdata/
*.moved-aside

# ── Generated by XcodeGen (source of truth is project.yml) ──
# The .xcodeproj and any generated Info.plist / entitlements are regenerated by
# `xcodegen generate`, so they are not tracked.
*.xcodeproj/
Config/*.plist
Config/*.entitlements

# ── Swift Package Manager (if ever added) ──
.build/
.swiftpm/
